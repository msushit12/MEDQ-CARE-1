# MedQ Care Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas URI or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/medq_care
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/medq_care?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=medq_care_jwt_super_secret_production_key_2026_healthcare
JWT_EXPIRES_IN=7d

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
